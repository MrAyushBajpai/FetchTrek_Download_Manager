import { DesignTokens } from "tokens.slint";

export enum TaskDisplayStatus {
    Downloading,
    Queued,
    Paused,
    Completed,
    Failed
}

export component StatusPill inherits Rectangle {
    in property <TaskDisplayStatus> status: TaskDisplayStatus.Downloading;

    height: 22px;
    border-radius: 4px;
    border-width: 1px;

    background: root.status == TaskDisplayStatus.Downloading ? DesignTokens.primary-blue.with-alpha(0.12) :
                root.status == TaskDisplayStatus.Queued ? DesignTokens.status-amber.with-alpha(0.12) :
                root.status == TaskDisplayStatus.Paused ? DesignTokens.status-yellow.with-alpha(0.12) :
                root.status == TaskDisplayStatus.Completed ? DesignTokens.status-green.with-alpha(0.12) :
                DesignTokens.status-red.with-alpha(0.12);

    border-color: root.status == TaskDisplayStatus.Downloading ? DesignTokens.primary-blue.with-alpha(0.28) :
                  root.status == TaskDisplayStatus.Queued ? DesignTokens.status-amber.with-alpha(0.28) :
                  root.status == TaskDisplayStatus.Paused ? DesignTokens.status-yellow.with-alpha(0.28) :
                  root.status == TaskDisplayStatus.Completed ? DesignTokens.status-green.with-alpha(0.28) :
                  DesignTokens.status-red.with-alpha(0.28);

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 3px;
        padding-bottom: 3px;
        alignment: center;

        Text {
            text: root.status == TaskDisplayStatus.Downloading ? "DOWNLOADING" :
                  root.status == TaskDisplayStatus.Queued ? "QUEUED" :
                  root.status == TaskDisplayStatus.Paused ? "PAUSED" :
                  root.status == TaskDisplayStatus.Completed ? "COMPLETED" : "FAILED";
            font-size: 10px;
            font-weight: 700;
            color: root.status == TaskDisplayStatus.Downloading ? DesignTokens.primary-blue :
                   root.status == TaskDisplayStatus.Queued ? DesignTokens.status-amber :
                   root.status == TaskDisplayStatus.Paused ? DesignTokens.status-yellow :
                   root.status == TaskDisplayStatus.Completed ? DesignTokens.status-green :
                   DesignTokens.status-red;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
