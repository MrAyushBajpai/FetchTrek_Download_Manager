import { DesignTokens } from "tokens.slint";
import { HeaderBar } from "header.slint";
import { Sidebar } from "sidebar.slint";
import { TaskTable, TaskRowData } from "task_table.slint";
import { TaskDisplayStatus } from "status_pill.slint";
import { Inspector, InspectorDetails, ChunkSlice, WorkerCursor } from "inspector.slint";
import { AddDownloadModal, AddTaskFormData } from "add_dialog.slint";
import { PreferencesModal, UserSettingsData } from "settings_modal.slint";

export { TaskRowData }
export { TaskDisplayStatus }
export { InspectorDetails, ChunkSlice, WorkerCursor }
export { AddTaskFormData }
export { UserSettingsData }

export component MainWindow inherits Window {
    title: "FetchTrek Download Manager";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 600px;
    default-font-family: "Segoe UI, Segoe UI Symbol, sans-serif";
    background: DesignTokens.surface-void;

    in-out property <[TaskRowData]> tasks;
    in-out property <string> active_category: "All Tasks";
    in property <int> count_all: 0;
    in property <int> count_downloading: 0;
    in property <int> count_paused: 0;
    in property <int> count_completed: 0;
    in property <int> count_failed: 0;
    in property <int> selected_count: 0;
    in property <string> aggregate_download_speed: "0.0 MB/s";
    in property <string> aggregate_upload_speed: "0.0 MB/s";
    in property <string> daemon_status: "Connecting...";

    in-out property <bool> is_inspector_expanded: true;
    in-out property <InspectorDetails> inspector_details;

    // Modals
    in-out property <bool> show_add_modal: false;
    in-out property <bool> show_settings_modal: false;
    in-out property <AddTaskFormData> add_form_data;
    in-out property <UserSettingsData> settings_data;

    callback add_download_clicked();
    callback resume_all_clicked();
    callback pause_all_clicked();
    callback settings_clicked();
    callback search_query_changed(string);
    callback filter_category_selected(string);
    callback row_selected(string);
    callback row_toggle_pause_resume(string);
    callback row_open_folder(string);
    callback row_delete(string);
    callback batch_resume_clicked();
    callback batch_pause_clicked();
    callback batch_delete_clicked();
    callback deselect_all_clicked();
    callback open_folder_clicked(string);
    callback copy_url_clicked(string);

    // Modal callbacks
    callback add_modal_submit(AddTaskFormData);
    callback add_modal_cancel();
    callback add_modal_paste_clipboard();
    callback add_modal_browse_path();
    callback settings_modal_save(UserSettingsData);
    callback settings_modal_cancel();
    callback settings_modal_browse_path();

    forward-focus: key_handler;
    key_handler := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                if root.show_add_modal {
                    root.add_modal_cancel();
                    return accept;
                }
                if root.show_settings_modal {
                    root.settings_modal_cancel();
                    return accept;
                }
            }
            reject
        }
    }

    VerticalLayout {
        spacing: 0px;

        // Global Header Bar (52px)
        HeaderBar {
            add_download_clicked => { root.add_download_clicked(); }
            resume_all_clicked => { root.resume_all_clicked(); }
            pause_all_clicked => { root.pause_all_clicked(); }
            settings_clicked => { root.settings_clicked(); }
            search_query_changed(query) => { root.search_query_changed(query); }
        }

        // Main Workstation Body
        HorizontalLayout {
            spacing: 0px;

            // Navigation Sidebar (220px)
            Sidebar {
                selected_category <=> root.active_category;
                count_all: root.count_all;
                count_downloading: root.count_downloading;
                count_paused: root.count_paused;
                count_completed: root.count_completed;
                count_failed: root.count_failed;
                download_speed: root.aggregate_download_speed;
                upload_speed: root.aggregate_upload_speed;
                daemon_status: root.daemon_status;
                filter_category_selected(cat) => { root.filter_category_selected(cat); }
            }

            // Central Work Area: Table + Collapsible Inspector Drawer
            VerticalLayout {
                horizontal-stretch: 1.0;
                spacing: 0px;

                TaskTable {
                    vertical-stretch: 1.0;
                    tasks <=> root.tasks;
                    selected_count: root.selected_count;
                    row_selected(id) => { root.row_selected(id); }
                    row_toggle_pause_resume(id) => { root.row_toggle_pause_resume(id); }
                    row_open_folder(id) => { root.row_open_folder(id); }
                    row_delete(id) => { root.row_delete(id); }
                    batch_resume_clicked => { root.batch_resume_clicked(); }
                    batch_pause_clicked => { root.batch_pause_clicked(); }
                    batch_delete_clicked => { root.batch_delete_clicked(); }
                    deselect_all_clicked => { root.deselect_all_clicked(); }
                }

                Inspector {
                    is_expanded <=> root.is_inspector_expanded;
                    details: root.inspector_details;
                    open_folder_clicked(path) => { root.open_folder_clicked(path); }
                    copy_url_clicked(url) => { root.copy_url_clicked(url); }
                    inspector_pause_resume_clicked(id) => { root.row_toggle_pause_resume(id); }
                    inspector_cancel_clicked(id) => { root.row_delete(id); }
                }
            }
        }
    }

    // Modal Dialog Overlays with Scrim
    if root.show_add_modal : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #00000099;

        TouchArea {
            clicked => { root.add_modal_cancel(); }
        }

        AddDownloadModal {
            form_data <=> root.add_form_data;
            submit(data) => { root.add_modal_submit(data); }
            cancel => { root.add_modal_cancel(); }
            paste_clipboard => { root.add_modal_paste_clipboard(); }
            browse_destination => { root.add_modal_browse_path(); }
        }
    }

    if root.show_settings_modal : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: #00000099;

        TouchArea {
            clicked => { root.settings_modal_cancel(); }
        }

        PreferencesModal {
            settings <=> root.settings_data;
            save(data) => { root.settings_modal_save(data); }
            cancel => { root.settings_modal_cancel(); }
            browse_default_path => { root.settings_modal_browse_path(); }
        }
    }
}
