import { ListView } from "std-widgets.slint";
import { DesignTokens } from "tokens.slint";
import { SmoothProgressBar } from "progress_bar.slint";
import { StatusPill, TaskDisplayStatus } from "status_pill.slint";

export struct TaskRowData {
    id: string,
    filename: string,
    file_type: string,
    total_size_formatted: string,
    progress: float,
    progress_percent_formatted: string,
    status: TaskDisplayStatus,
    speed_formatted: string,
    eta_formatted: string,
    is_selected: bool,
}

component RowActionButton inherits Rectangle {
    in property <string> icon;
    in property <color> icon_color: DesignTokens.text-secondary;
    callback clicked();

    width: 24px;
    height: 24px;
    border-radius: 4px;
    background: btn_touch.pressed ? DesignTokens.surface-inset :
                btn_touch.has-hover ? DesignTokens.surface-hover : #00000000;

    btn_touch := TouchArea {
        clicked => { root.clicked(); }
    }

    Text {
        text: root.icon;
        font-size: 11px;
        font-family: "Segoe UI Symbol";
        font-weight: 700;
        color: btn_touch.has-hover ? (root.icon == "✕" ? DesignTokens.status-red : DesignTokens.text-primary) : root.icon_color;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component TaskTableRow inherits Rectangle {
    in property <TaskRowData> data;
    callback select_clicked();
    callback toggle_pause_resume();
    callback open_folder();
    callback delete_clicked();

    height: 38px;
    background: root.data.is_selected ? DesignTokens.surface-selected :
                row_touch.has-hover ? DesignTokens.surface-hover : DesignTokens.surface-card;

    animate background {
        duration: 80ms;
        easing: ease-out;
    }

    row_touch := TouchArea {
        clicked => { root.select_clicked(); }
    }

    // Bottom hairline divider
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: root.data.is_selected ? DesignTokens.border-selected : DesignTokens.border-hairline;
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 8px;

        // 1. Select Checkbox (32px)
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 32px;
                height: 16px;

                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 3px;
                    border-width: 1px;
                    border-color: root.data.is_selected ? DesignTokens.primary-blue : DesignTokens.border-focus;
                    background: root.data.is_selected ? DesignTokens.primary-blue : DesignTokens.surface-input;

                    if root.data.is_selected : Text {
                        text: "✓";
                        font-size: 11px;
                        font-weight: 800;
                        color: #ffffff;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    clicked => { root.select_clicked(); }
                }
            }
        }

        // 2. Filename & Type Icon (flex 1.0, min-width 220px)
        HorizontalLayout {
            horizontal-stretch: 1.0;
            min-width: 220px;
            spacing: 8px;

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 28px;
                    height: 18px;
                    border-radius: 3px;
                    background: DesignTokens.surface-inset;
                    border-width: 1px;
                    border-color: DesignTokens.border-hairline;

                    Text {
                        text: root.data.file_type;
                        font-size: 8px;
                        font-weight: 700;
                        color: DesignTokens.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Text {
                text: root.data.filename;
                font-size: 12px;
                font-weight: 600;
                color: DesignTokens.text-primary;
                overflow: elide;
                vertical-alignment: center;
            }
        }

        // 3. Total Size (90px, right-aligned)
        Rectangle {
            width: 90px;

            Text {
                text: root.data.total_size_formatted;
                font-size: 11px;
                font-family: "monospace";
                color: DesignTokens.text-secondary;
                horizontal-alignment: end;
                vertical-alignment: center;
            }
        }

        // 4. Progress Bar & Percent (200px: flexible bar + 48px monospace label)
        HorizontalLayout {
            width: 200px;
            spacing: 10px;

            VerticalLayout {
                horizontal-stretch: 1.0;
                alignment: center;
                SmoothProgressBar {
                    progress: root.data.progress;
                    fill-color: root.data.status == TaskDisplayStatus.Completed ? DesignTokens.status-green :
                                root.data.status == TaskDisplayStatus.Paused ? DesignTokens.status-yellow :
                                root.data.status == TaskDisplayStatus.Failed ? DesignTokens.status-red :
                                DesignTokens.primary-blue;
                }
            }

            Text {
                width: 48px;
                text: root.data.progress_percent_formatted;
                font-size: 11px;
                font-family: "monospace";
                color: DesignTokens.text-primary;
                horizontal-alignment: end;
                vertical-alignment: center;
            }
        }

        // 5. Status Pill (115px, centered)
        HorizontalLayout {
            width: 115px;
            alignment: center;

            VerticalLayout {
                alignment: center;
                StatusPill {
                    status: root.data.status;
                }
            }
        }

        // 6. Speed (95px, right-aligned)
        Rectangle {
            width: 95px;

            Text {
                text: root.data.speed_formatted;
                font-size: 11px;
                font-family: "monospace";
                color: root.data.speed_formatted == "--" ? DesignTokens.text-muted : DesignTokens.primary-blue;
                horizontal-alignment: end;
                vertical-alignment: center;
            }
        }

        // 7. ETA (85px, right-aligned)
        Rectangle {
            width: 85px;

            Text {
                text: root.data.eta_formatted;
                font-size: 11px;
                font-family: "monospace";
                color: root.data.eta_formatted == "--:--:--" ? DesignTokens.text-muted : DesignTokens.text-secondary;
                horizontal-alignment: end;
                vertical-alignment: center;
            }
        }

        // 8. Row Actions (100px, centered)
        HorizontalLayout {
            width: 100px;
            alignment: center;
            spacing: 6px;

            RowActionButton {
                icon: root.data.status == TaskDisplayStatus.Downloading ? "❚❚" : "▶";
                icon_color: root.data.status == TaskDisplayStatus.Downloading ? DesignTokens.status-yellow : DesignTokens.primary-blue;
                clicked => { root.toggle_pause_resume(); }
            }

            RowActionButton {
                icon: "⌕";
                icon_color: DesignTokens.text-secondary;
                clicked => { root.open_folder(); }
            }

            RowActionButton {
                icon: "✕";
                icon_color: DesignTokens.text-muted;
                clicked => { root.delete_clicked(); }
            }
        }
    }
}

export component TaskTable inherits Rectangle {
    in-out property <[TaskRowData]> tasks;
    in property <int> selected_count: 0;

    callback row_selected(string);
    callback row_toggle_pause_resume(string);
    callback row_open_folder(string);
    callback row_delete(string);
    callback batch_resume_clicked();
    callback batch_pause_clicked();
    callback batch_delete_clicked();
    callback deselect_all_clicked();

    background: DesignTokens.surface-void;

    VerticalLayout {
        // Dynamic Batch Action Bar
        if root.selected_count > 0 : Rectangle {
            height: 40px;
            background: DesignTokens.surface-selected;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: DesignTokens.primary-blue;
            }

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 12px;
                alignment: space-between;

                VerticalLayout {
                    alignment: center;
                    HorizontalLayout {
                        spacing: 12px;

                        Text {
                            text: root.selected_count + " items selected";
                            font-size: 12px;
                            font-weight: 700;
                            color: DesignTokens.text-primary;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            background: DesignTokens.surface-hover;
                            border-width: 1px;
                            border-color: DesignTokens.border-hairline;

                            TouchArea {
                                clicked => { root.batch_resume_clicked(); }
                            }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 4px;
                                alignment: center;

                                Text {
                                    text: "▶ Resume";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: DesignTokens.primary-blue;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            background: DesignTokens.surface-hover;
                            border-width: 1px;
                            border-color: DesignTokens.border-hairline;

                            TouchArea {
                                clicked => { root.batch_pause_clicked(); }
                            }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 4px;
                                alignment: center;

                                Text {
                                    text: "❚❚ Pause";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: DesignTokens.status-yellow;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            background: DesignTokens.status-red.with-alpha(0.15);
                            border-width: 1px;
                            border-color: DesignTokens.status-red.with-alpha(0.3);

                            TouchArea {
                                clicked => { root.batch_delete_clicked(); }
                            }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 4px;
                                alignment: center;

                                Text {
                                    text: "✕ Remove";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: DesignTokens.status-red;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: DesignTokens.surface-card;
                        border-width: 1px;
                        border-color: DesignTokens.border-hairline;

                        TouchArea {
                            clicked => { root.deselect_all_clicked(); }
                        }

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            alignment: center;

                            Text {
                                text: "Deselect All";
                                font-size: 11px;
                                font-weight: 500;
                                color: DesignTokens.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Table Column Header (34px)
        Rectangle {
            height: 34px;
            background: DesignTokens.surface-table-header;

            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: DesignTokens.border-hairline;
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;

                // Col 1: # (32px)
                Rectangle {
                    width: 32px;
                    Text {
                        text: "#";
                        font-size: 10px;
                        font-weight: 700;
                        color: DesignTokens.text-muted;
                        vertical-alignment: center;
                    }
                }

                // Col 2: FILENAME (flex 1.0, min-width 220px)
                HorizontalLayout {
                    horizontal-stretch: 1.0;
                    min-width: 220px;
                    Text {
                        text: "FILENAME";
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 0.5px;
                        color: DesignTokens.text-muted;
                        vertical-alignment: center;
                    }
                }

                // Col 3: TOTAL SIZE (90px, right-aligned)
                Rectangle {
                    width: 90px;
                    Text {
                        text: "TOTAL SIZE";
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 0.5px;
                        color: DesignTokens.text-muted;
                        horizontal-alignment: end;
                        vertical-alignment: center;
                    }
                }

                // Col 4: PROGRESS (200px)
                Rectangle {
                    width: 200px;
                    Text {
                        text: "PROGRESS";
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 0.5px;
                        color: DesignTokens.text-muted;
                        vertical-alignment: center;
                    }
                }

                // Col 5: STATUS (115px, centered)
                Rectangle {
                    width: 115px;
                    Text {
                        text: "STATUS";
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 0.5px;
                        color: DesignTokens.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Col 6: SPEED (95px, right-aligned)
                Rectangle {
                    width: 95px;
                    Text {
                        text: "SPEED";
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 0.5px;
                        color: DesignTokens.text-muted;
                        horizontal-alignment: end;
                        vertical-alignment: center;
                    }
                }

                // Col 7: ETA (85px, right-aligned)
                Rectangle {
                    width: 85px;
                    Text {
                        text: "ETA";
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 0.5px;
                        color: DesignTokens.text-muted;
                        horizontal-alignment: end;
                        vertical-alignment: center;
                    }
                }

                // Col 8: ACTIONS (100px, centered)
                Rectangle {
                    width: 100px;
                    Text {
                        text: "ACTIONS";
                        font-size: 10px;
                        font-weight: 700;
                        letter-spacing: 0.5px;
                        color: DesignTokens.text-muted;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Virtualized Task Table Rows
        ListView {
            for task in root.tasks : TaskTableRow {
                data: task;
                select_clicked => { root.row_selected(task.id); }
                toggle_pause_resume => { root.row_toggle_pause_resume(task.id); }
                open_folder => { root.row_open_folder(task.id); }
                delete_clicked => { root.row_delete(task.id); }
            }
        }
    }
}
