import { DesignTokens } from "tokens.slint";

export struct ChunkSlice {
    start_ratio: float,
    width_ratio: float,
    is_verified: bool,
}

export struct WorkerCursor {
    position_ratio: float,
}

export component ChunkMap inherits Rectangle {
    in property <[ChunkSlice]> chunks;
    in property <[WorkerCursor]> cursors;

    height: 24px;
    background: DesignTokens.surface-inset;
    border-radius: 4px;
    border-width: 1px;
    border-color: DesignTokens.border-hairline;
    clip: true;

    // Render downloaded slices
    for chunk in root.chunks : Rectangle {
        x: parent.width * Math.max(0.0, Math.min(1.0, chunk.start_ratio));
        width: parent.width * Math.max(0.0, Math.min(1.0, chunk.width_ratio));
        height: parent.height;
        background: chunk.is_verified ? DesignTokens.status-green : DesignTokens.primary-blue;
    }

    // Render active worker cursor needles
    for cursor in root.cursors : Rectangle {
        x: parent.width * Math.max(0.0, Math.min(1.0, cursor.position_ratio)) - 1px;
        width: 2px;
        height: parent.height;
        background: #ffffff;
    }
}
