import { DesignTokens } from "tokens.slint";

export component SpeedChart inherits Rectangle {
    in property <[float]> points;
    in property <string> peak_speed: "--";

    height: 64px;
    background: DesignTokens.surface-inset;
    border-radius: 4px;
    border-width: 1px;
    border-color: DesignTokens.border-hairline;
    clip: true;

    // Midline grid guide
    Rectangle {
        y: parent.height * 0.5;
        height: 1px;
        background: DesignTokens.border-hairline;
    }

    // 60-second throughput histogram bars
    for val[idx] in root.points : Rectangle {
        x: parent.width * (idx / 60.0);
        width: Math.max(1px, (parent.width / 60.0) - 1px);
        y: parent.height * (1.0 - Math.max(0.04, Math.min(1.0, val)));
        height: parent.height * Math.max(0.04, Math.min(1.0, val));
        background: DesignTokens.primary-blue.with-alpha(0.35);

        // Highlight cap needle
        Rectangle {
            y: 0px;
            height: 2px;
            background: DesignTokens.primary-blue;
        }
    }

    // Top-left peak label
    Rectangle {
        x: 8px;
        y: 6px;
        background: DesignTokens.surface-void.with-alpha(0.7);
        border-radius: 3px;

        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            padding-top: 2px;
            padding-bottom: 2px;

            Text {
                text: "Peak: " + root.peak_speed;
                font-size: 10px;
                font-family: "monospace";
                font-weight: 600;
                color: DesignTokens.text-secondary;
                vertical-alignment: center;
            }
        }
    }

    // Bottom-right 60s label
    Rectangle {
        x: parent.width - self.width - 8px;
        y: parent.height - self.height - 6px;

        Text {
            text: "60s";
            font-size: 10px;
            font-family: "monospace";
            color: DesignTokens.text-muted;
            vertical-alignment: center;
        }
    }
}
